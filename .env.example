# Copy to .env for local overrides. docker compose and the backend both read it.
# Every backend setting is GRAPHY_<NAME>; see backend/graphy/config.py for the full list.

# Database passwords used by docker-compose.yml (dev defaults shown).
POSTGRES_PASSWORD=graphy
NEO4J_PASSWORD=graphy-dev-password

# Keyed hash for SSNs and account numbers. Must be set (and kept secret) outside dev.
# GRAPHY_HASH_KEY=

# Dev mode signs everyone in as GRAPHY_DEV_USER with these roles.
# GRAPHY_DEV_ROLES=["analyst","steward","detection_analyst","compliance","admin"]

# OIDC (staging/prod):
# GRAPHY_AUTH_MODE=oidc
# GRAPHY_OIDC_ISSUER=https://login.example.com/
# GRAPHY_OIDC_AUDIENCE=graphy-api
# GRAPHY_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# GRAPHY_OIDC_ROLE_MAP={"graphy-analysts":"analyst","graphy-stewards":"steward","graphy-compliance":"compliance"}
